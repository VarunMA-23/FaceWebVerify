# Face-Web-Blockchain Pipeline — Secrets
# Copy to .env and fill in. NEVER commit this file.

# --- Server ports (local) ---
BACKEND_PORT=8004
FRONTEND_PORT=3004
BACKEND_URL=http://127.0.0.1:8004
# When false, FastAPI serves API only; frontend runs on FRONTEND_PORT separately.
SERVE_FRONTEND=false

# Blockchain in API: auto | true | false
DO_BLOCKCHAIN=auto

# --- Visual Search ---
# Provide at least one of the following:

# Microsoft Bing Visual Search API
BING_SEARCH_API_KEY=

# OpenWeb Ninja (Google Lens reverse image search) — takes an image URL,
# so local uploads are temporarily published to a public host first.
OPENWEBNINJA_API_KEY=

# SerpAPI (reverse image search)
SERPAPI_API_KEY=

# TinEye API
TINEYE_API_KEY=

# --- Blockchain (Sepolia testnet) ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_WALLET_PRIVATE_KEY=
SEPOLIA_CONTRACT_ADDRESS=