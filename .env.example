# Face-Web-Blockchain Pipeline — Secrets
# Copy to .env and fill in. NEVER commit this file.

# --- Server ports (local) ---
BACKEND_PORT=8004
FRONTEND_PORT=3004
BACKEND_URL=http://127.0.0.1:8004
# When false, FastAPI serves API only; frontend runs on FRONTEND_PORT separately.
SERVE_FRONTEND=false

# Blockchain in API
#   DO_BLOCKCHAIN     master switch: 0|false|no|off|none disables anchoring
#   BLOCKCHAIN_ANCHOR default backend: local (Merkle ledger) | evm | auto | none
#   BLOCKCHAIN_CHAIN_DIR   chain data directory (default ./chaindata)
#   BLOCKCHAIN_DIFFICULTY  PoW difficulty bits for the local chain (0 -> off)
DO_BLOCKCHAIN=true
BLOCKCHAIN_ANCHOR=local
BLOCKCHAIN_CHAIN_DIR=
BLOCKCHAIN_DIFFICULTY=0

# --- Visual Search ---
# Provide at least one of the following.  If none are configured, the
# pipeline falls back to keyless public social APIs (Bluesky/Mastodon/Reddit)
# seeded by `--hint`.

# Microsoft Bing Visual Search API
BING_SEARCH_API_KEY=

# OpenWeb Ninja (Google Lens reverse image search) — takes an image URL,
# so local uploads are temporarily published to a public host first.
OPENWEBNINJA_API_KEY=

# SerpAPI (reverse image search)
SERPAPI_API_KEY=

# TinEye API
TINEYE_API_KEY=

# --- Keyless Social Fallback ---
# Optional text hint (e.g. subject's name) used to seed Bluesky/Mastodon/Reddit
# searches when no reverse-image API keys above are configured.
# NOTE: pass this per-run via the CLI (--hint) or the API form field, not here,
# as it is not read from the environment.

# --- Blockchain EVM (optional; requires `pip install -r requirements-evm.txt`) ---
# Only used when BLOCKCHAIN_ANCHOR=evm.
#   EVM_MODE      registry (contract, needs SEPOLIA_CONTRACT_ADDRESS)
#                 | calldata (pure calldata, no contract) | auto
#   EVM_CONFIRMATIONS  blocks to wait for finality checks
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_WALLET_PRIVATE_KEY=
SEPOLIA_CONTRACT_ADDRESS=
EVM_MODE=auto
EVM_CONFIRMATIONS=1